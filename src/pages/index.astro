---
// 首页：展示所有博客文章的毛玻璃卡片列表
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const posts = await getCollection('blog')
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
---

<BaseLayout title="My Blog — 首页" description="个人博客，分享技术与生活">
  <!-- 顶部渐变装饰条 -->
  <div class="h-1 w-24 gradient-bg rounded-full mx-auto mb-8"></div>

  <h1 class="text-3xl sm:text-4xl font-bold text-center mb-2">最新文章</h1>
  <p class="text-gray-500 text-center mb-10 text-sm">共 {posts.length} 篇</p>

  <!-- 文章卡片网格 -->
  <div class="grid gap-6 sm:grid-cols-2">
    {posts.map((post) => (
      <a href={`/${post.slug}`} class="glass p-5 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 group block">
        <!-- 封面图（可选） -->
        {post.data.image && (
          <img src={post.data.image} alt={post.data.title} class="w-full h-36 object-cover rounded-lg mb-4" />
        )}
        <div class="flex flex-wrap gap-2 mb-2">
          {post.data.tags.map((tag) => (
            <span class="text-xs font-medium text-primary-500 bg-primary-50 px-2.5 py-0.5 rounded-full">
              #{tag}
            </span>
          ))}
        </div>
        <h2 class="text-lg font-semibold text-gray-900 group-hover:text-primary-600 transition line-clamp-2">
          {post.data.title}
        </h2>
        <p class="text-sm text-gray-500 mt-1.5 line-clamp-2">{post.data.description}</p>
        <time class="text-xs text-gray-400 mt-3 block">
          {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </a>
    ))}
  </div>
</BaseLayout>
